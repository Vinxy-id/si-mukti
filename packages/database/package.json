{
  "name": "@si-mukti/database",
  "version": "1.0.0",
  "description": "PostgreSQL 16 + PostGIS Drizzle ORM Schema, Spatial Queries & Types for SI-MUKTI Tulungagung",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./spatial": "./src/helpers/spatial.ts",
    "./crypto": "./src/helpers/crypto.ts",
    "./client": "./src/client.ts"
  },
  "scripts": {
    "build": "tsc",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/migrate.ts",
    "db:seed": "tsx src/seed.ts",
    "test": "tsx src/test-spatial.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.33.0",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.9",
    "@types/pg": "^8.11.6",
    "drizzle-kit": "^0.24.2",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4"
  }
}
